/// Generates Prisma client for DB access
generator client {
  provider = "prisma-client-js"
}

/// PostgreSQL datasource
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─── AUTH & USER CORE ──────────────────────────────────────────────────────────
//

/// Stores core user auth credentials and metadata
model User {
  id              String  @id @default(uuid())
  email           String? @unique
  phone           String? @unique
  passwordHash    String?
  firebaseUid     String? @unique
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isAdmin         Boolean @default(false)

  sessions          Session[]
  otps              Otp[]
  loginLogs         LoginAuditLog[]
  userNotifications UserNotification[]
  profiles          Profile[]
  Report            Report[]
  AdminActionLog    AdminActionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Session-based login token for auth
model Session {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String
  deviceInfo String
  userAgent  String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// OTP for phone/email verification
model Otp {
  id         String    @id @default(uuid())
  userId     String
  code       String
  type       OtpType
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Logs all login attempts (success/fail)
model LoginAuditLog {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

/// Notifications for user (not profile-specific)
model UserNotification {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  title  String
  body   String
  readAt DateTime?
  sentAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

//
// ─── PROFILE & MATCHMAKING ─────────────────────────────────────────────────────
//

/// Represents a matrimonial profile created by user
model Profile {
  id        String @id @default(uuid())
  profileId String @unique
  userId    String

  firstName   String
  lastName    String
  gender      Gender
  dateOfBirth DateTime
  createdFor  CreatedFor @default(SELF)

  maritalStatus      MaritalStatus    @default(NEVER_MARRIED)
  childrenCount      Int?             @default(0)
  childrenLivingWith UserChildStatus?

  religion              String?
  caste                 String?
  subCaste              String?
  allowOtherCommunities Boolean?     @default(false)
  hasDosham             Boolean?     @default(false)
  doshamTypes           DoshamType[]

  familyStatus FamilyStatus?
  familyType   FamilyType?
  familyValues FamilyValue?

  height     Float?
  disability Boolean? @default(false)

  highestEducation String?
  employedIn       EmploymentType?
  occupation       String?
  annualIncome     String?

  country        String?
  state          String?
  city           String?
  citizenship    String?
  residentStatus String?

  isProfileVerified Boolean   @default(false)
  isHighlighted     Boolean   @default(false)
  highlightedUntil  DateTime?
  isPremium         Boolean   @default(false)
  premiumUntil      DateTime?

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImages        ProfileImage[]
  preferences          Preference?
  horoscope            Horoscope?
  lifestyle            Lifestyle?
  trustScore           TrustScore?
  profileNotifications ProfileNotification[]
  interestsSent        Interest[]            @relation("ProfileInterestsSent")
  interestsReceived    Interest[]            @relation("ProfileInterestsReceived")
  messages             Message[]
  payments             Payment[]
  reports              Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Profile image with approval and visibility control
model ProfileImage {
  id         String          @id @default(uuid())
  profileId  String
  url        String
  isPrimary  Boolean         @default(false)
  isApproved Boolean         @default(false)
  visibility ImageVisibility @default(PUBLIC)
  uploadedAt DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// Interest requests between profiles
model Interest {
  id                String         @id @default(uuid())
  senderProfileId   String
  receiverProfileId String
  status            InterestStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now())

  sender   Profile @relation("ProfileInterestsSent", fields: [senderProfileId], references: [id])
  receiver Profile @relation("ProfileInterestsReceived", fields: [receiverProfileId], references: [id])
}

/// Notification related to a profile (e.g., interest received)
model ProfileNotification {
  id        String                  @id @default(uuid())
  profileId String
  type      ProfileNotificationType
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime                @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
}

/// Chat messages sent by profile
model Message {
  id        String        @id @default(uuid())
  profileId String
  content   String
  sender    MessageSender
  sentAt    DateTime      @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

//
// ─── PLANS & PAYMENTS ──────────────────────────────────────────────────────────
//

/// Payment record of a premium plan for profile
model Payment {
  id            String         @id @default(uuid())
  profileId     String
  planId        String
  amount        Int
  status        PaymentStatus
  gateway       PaymentGateway
  transactionId String
  paidAt        DateTime
  createdAt     DateTime       @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])
}

/// Subscription plans available for purchase
model Plan {
  id           String   @id @default(uuid())
  name         String
  price        Int
  durationDays Int
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  payments Payment[]
}

//
// ─── PREFERENCES & ATTRIBUTES ──────────────────────────────────────────────────
//

/// Preferred partner criteria
model Preference {
  id                   String  @id @default(uuid())
  profileId            String  @unique
  preferredAgeRangeMin Int?
  preferredAgeRangeMax Int?
  preferredCaste       String?
  preferredEducation   String?

  profile Profile @relation(fields: [profileId], references: [id])
}

/// Horoscope details (optional)
model Horoscope {
  id        String  @id @default(uuid())
  profileId String  @unique
  rasi      String?
  nakshatra String?
  gothram   String?

  profile Profile @relation(fields: [profileId], references: [id])
}

/// Lifestyle habits for profile
model Lifestyle {
  id        String       @id @default(uuid())
  profileId String       @unique
  foodHabit FoodHabit?
  smoking   HabitStatus?
  drinking  HabitStatus?

  profile Profile @relation(fields: [profileId], references: [id])
}

/// Trust score breakdown
model TrustScore {
  id          String @id @default(uuid())
  profileId   String @unique
  photoScore  Int    @default(0)
  aadharScore Int    @default(0)
  socialScore Int    @default(0)
  overall     Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id])
}

//
// ─── REPORTING & ADMIN ─────────────────────────────────────────────────────────
//

/// Reports submitted by users against profiles
model Report {
  id        String       @id @default(uuid())
  profileId String
  userId    String
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

/// Admin-side audit log for actions (e.g., approve images, ban users)
model AdminActionLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  notes     String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}

//
// ─── ENUMS ──────────────────────────────────────────────────────────────────────
//

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CreatedFor {
  SELF
  SON
  DAUGHTER
  SIBLING
  FRIEND
  OTHER
}

enum OtpType {
  PHONE
  EMAIL
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum UserChildStatus {
  LIVING_WITH_ME
  NOT_LIVING_WITH_ME
}

enum FamilyStatus {
  MIDDLE_CLASS
  UPPER_MIDDLE_CLASS
  AFFLUENT
  RICH
}

enum FamilyType {
  JOINT
  NUCLEAR
  EXTENDED
}

enum FamilyValue {
  TRADITIONAL
  MODERATE
  LIBERAL
}

enum EmploymentType {
  GOVERNMENT
  PRIVATE
  BUSINESS
  DEFENCE
  SELF_EMPLOYED
  NOT_WORKING
}

enum DoshamType {
  KUJA
  NAGA
  KALA_SARPA
  RAHU
  KETHU
  KALATHRA
}

enum ImageVisibility {
  PUBLIC
  PRIVATE
}

enum MessageSender {
  SELF
  MATCH
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  INAPP
}

enum ProfileNotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  MESSAGE_RECEIVED
  MATCH_FOUND
  PLAN_EXPIRED
  ADMIN_NOTE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASHFREE
}

enum FoodHabit {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  VEGAN
}

enum HabitStatus {
  YES
  NO
  OCCASIONALLY
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}
