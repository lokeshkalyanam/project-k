{
  // Compiler settings to control how TypeScript behaves
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    // Next.js specific plugin for improved type support
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  // Files and directories to include in the TypeScript project
  "include": [
    "src",
    ".next/types/**/*.ts"
  ],
  // Files and directories to exclude from the TypeScript project
  "exclude": [
    "node_modules",
    "dist"
  ]
}